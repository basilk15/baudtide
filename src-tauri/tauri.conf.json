{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BaudTide",
  "version": "0.3.0",
  "identifier": "com.basil.baudtide",
  "build": {
    "beforeDevCommand": "node scripts/prepare-linux-dev-desktop-entry.mjs && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "enableGTKAppId": true,
    "windows": [
      {
        "title": "BaudTide",
        "width": 1320,
        "height": 850,
        "minWidth": 900,
        "minHeight": 650
      }
    ],
    "security": {
      "csp": "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'none'; script-src 'self'; script-src-attr 'none'; style-src 'self'; style-src-attr 'none'; img-src 'self' asset: http://asset.localhost data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost; media-src 'none'; worker-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "linux/legacy-desktop-entry.hbs",
        "files": {
          "/usr/share/applications/com.basil.baudtide.desktop": "linux/com.basil.baudtide.desktop"
        }
      },
      "rpm": {
        "desktopTemplate": "linux/legacy-desktop-entry.hbs",
        "files": {
          "/usr/share/applications/com.basil.baudtide.desktop": "linux/com.basil.baudtide.desktop"
        }
      },
      "appimage": {
        "files": {
          "/com.basil.baudtide.desktop": "linux/com.basil.baudtide.desktop",
          "/usr/share/applications/com.basil.baudtide.desktop": "linux/com.basil.baudtide.desktop"
        }
      }
    }
  }
}
