{
  "name": "baudtide",
  "private": true,
  "version": "0.3.0",
  "description": "A focused desktop serial monitor for embedded development.",
  "license": "MIT",
  "author": "Basil Khowaja <bk08432@st.habib.edu.pk>",
  "homepage": "https://github.com/basilk15/baudtide",
  "repository": {
    "type": "git",
    "url": "https://github.com/basilk15/baudtide.git"
  },
  "desktopName": "com.basil.baudtide.desktop",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b --pretty false",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "electron": "node scripts/run-electron.mjs",
    "electron:dev": "node scripts/run-electron.mjs",
    "native:build": "cargo build --manifest-path src-native/Cargo.toml --locked",
    "native:release": "cargo build --manifest-path src-native/Cargo.toml --release --locked",
    "desktop:pack": "npm run build && npm run native:release && electron-builder --linux --dir",
    "desktop:dist": "npm run build && npm run native:release && electron-builder --linux",
    "format:check": "cargo fmt --manifest-path src-native/Cargo.toml --all -- --check",
    "lint:rust": "cargo clippy --manifest-path src-native/Cargo.toml --all-targets --locked -- -D warnings",
    "test:rust": "cargo test --manifest-path src-native/Cargo.toml --locked",
    "test:frontend": "vitest run",
    "test:telemetry": "vitest run src/lib/telemetry.test.ts src/lib/telemetryChart.test.ts src/lib/telemetryFixtures.test.ts",
    "test": "npm run test:frontend && npm run test:rust",
    "check": "npm run format:check && npm run lint:rust && npm run build",
    "audit:prod": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "echarts": "^6.1.0",
    "lucide-react": "1.24.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "recharts": "^3.10.1",
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "electron": "43.4.1",
    "electron-builder": "26.15.3",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
